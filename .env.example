# ==============================================================================
# TBO InventoryIQ — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and customize the values for your local or production environment.
# Note: In production (ENVIRONMENT=production), strict validation is enforced:
# - Insecure default keys or keys shorter than 32 characters are prohibited.
# - Wildcard '*' CORS origins are strictly forbidden.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Server Settings
# ------------------------------------------------------------------------------
PROJECT_NAME="TBO InventoryIQ API"
VERSION="1.0.0"
ENVIRONMENT=development
API_V1_STR="/api/v1"
DEBUG=true
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. Database Connection & Connection Pooling
# ------------------------------------------------------------------------------
# PostgreSQL (Production / Development):
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# Note: For URL special characters in password (e.g., @ or #), use URL encoding (%40, %23)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/Travelprofitai

# In-memory or file-based SQLite database used during automated test suites
DATABASE_TEST_URL=sqlite:///:memory:

# SQLAlchemy Connection Pool Configuration (PostgreSQL / MySQL)
# Number of persistent connections kept in the connection pool
DB_POOL_SIZE=10
# Maximum temporary connections allowed beyond DB_POOL_SIZE during traffic spikes
DB_MAX_OVERFLOW=20
# Maximum seconds to wait before timing out when getting a connection from pool
DB_POOL_TIMEOUT=30
# Recycle connections after specified seconds to prevent dropped stale sockets
DB_POOL_RECYCLE=1800
# Echo SQL statements to stdout (enable for query debugging)
DB_ECHO=false

# ------------------------------------------------------------------------------
# 3. Security, Cryptography & Authentication (JWT)
# ------------------------------------------------------------------------------
# Cryptographic secret key used to sign and verify JWT tokens (minimum 32 characters)
SECRET_KEY=change_this_to_a_secure_random_secret_key_at_least_32_chars_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ACTION_TOKEN_EXPIRE_HOURS=24
WORKER_SECRET_TOKEN=change_this_to_a_secure_worker_secret_token

# ------------------------------------------------------------------------------
# 4. Asynchronous Task Queue & Cache (Celery / Redis)
# ------------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 5. Local File Storage Directories
# ------------------------------------------------------------------------------
UPLOAD_DIR=data/uploads
ARTIFACT_DIR=data/artifacts
REPORTS_DIR=data/reports

# ------------------------------------------------------------------------------
# 6. CORS & Real-Time Engine (Socket.IO)
# ------------------------------------------------------------------------------
# JSON-formatted list or comma-separated list of allowed HTTP origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Real-time WebSocket / Socket.IO event notifications
SOCKET_IO_ENABLED=true
SOCKET_IO_PATH=/socket.io
SOCKET_IO_PING_INTERVAL=25
SOCKET_IO_PING_TIMEOUT=20
SOCKET_IO_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ------------------------------------------------------------------------------
# 7. Mathematical Optimization & Procurement Engine
# ------------------------------------------------------------------------------
OPTIMIZATION_CONFIG_VERSION=1
