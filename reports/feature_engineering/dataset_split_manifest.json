        "records": 2,
        "pct": 50.0,
        "days_left_range": [
          15,
          49
        ],
        "avg_price_inr": 5500.0
      },
      "validation": {
        "records": 1,
        "pct": 25.0,
        "days_left_range": [
          8,
          14
        ],
        "avg_price_inr": 9000.0
      },
      "test": {
        "records": 1,
        "pct": 25.0,
        "days_left_range": [
          1,
          7
        ],
        "avg_price_inr": 15000.0
      }
    }
  }
